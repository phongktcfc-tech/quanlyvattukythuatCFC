# MẪU CẤU HÌNH KHÓA BÍ MẬT
# - Chạy local: sao chép thành .streamlit/secrets.toml rồi điền giá trị thật
# - Streamlit Cloud: dán nội dung vào App → Settings → Secrets

GOOGLE_API_KEY = ""
NVIDIA_API_KEY = ""

# Lưu dữ liệu bền vững (mã đã duyệt, kho, báo cáo) lên nhánh data-store của GitHub.
# Tạo fine-grained token: chỉ repo này, quyền Contents = Read and write. Bỏ trống = tắt tính năng.
GITHUB_TOKEN = ""
GITHUB_REPO = "phongktcfc-tech/quanlyvattukythuatCFC"

EMAIL_ADDRESS = ""
EMAIL_APP_PASSWORD = ""
RECIPIENT_EMAIL = ""
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
